{
  "name": "scope-variation-board",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp staticwebapp.config.json dist/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:claims": "playwright test --grep @claim",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.4.1",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "3.2.6"
  }
}
